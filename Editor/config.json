{
    "ecs": {
        "mt": {
            "enable_parallel_physics_world_step": true,
            "enable_parallel_scripts": true,
            "enable_parallel_transforms": true,
            "enable_system_scheduler": true,
            "require_parallel_script_access_declarations": true,
            "validate_parallel_script_access_masks": true,
            "warn_implicit_parallel_script_access": true,
            "warn_parallel_script_access_mismatch": true
        }
    },
    "logging": {
        "app_level": "debug",
        "console_enabled": true,
        "core_level": "debug",
        "directory": "logs",
        "file_enabled": true,
        "level": "info",
        "max_file_size": 52428800,
        "max_files": 10,
        "pattern": "[%T] [%l] %n: %v"
    },
    "physics2d": {
        "debug_kinematic_motion": true
    },
    "system": {
        "log_directory": "logs",
        "max_threads": 20,
        "temp_directory": "temp",
        "working_directory": "."
    },
    "window": {
        "fullscreen": false,
        "height": 720,
        "icon": "LimitlessLogo.ico",
        "resizable": true,
        "title": "Limitless Editor",
        "vsync": false,
        "width": 1280
    }
}