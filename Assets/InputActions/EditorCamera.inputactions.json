{
  "maps": [
    {
      "name": "Editor",
      "enabled": true,
      "actions": [
        {
          "name": "Move",
          "type": "Axis2D",
          "bindings": [
            { "binding": "KeyboardAxis2D", "up": "W", "down": "S", "left": "A", "right": "D", "scale": 1.0 },
            { "binding": "GamepadAxis2D", "x_axis": "leftx", "y_axis": "lefty", "deadzone": 0.15, "scale": 1.0, "invert_y": false }
          ]
        },
        {
          "name": "Look",
          "type": "Axis2D",
          "bindings": [
            { "binding": "MouseDelta", "sensitivity": 1.0, "invert_y": false },
            { "binding": "GamepadAxis2D", "x_axis": "rightx", "y_axis": "righty", "deadzone": 0.15, "scale": 1.0, "invert_y": true }
          ]
        },
        {
          "name": "Boost",
          "type": "Button",
          "bindings": [
            { "binding": "KeyboardButton", "key": "Left Shift" },
            { "binding": "GamepadButton", "button": "leftshoulder" }
          ]
        },
        {
          "name": "LookEnable",
          "type": "Button",
          "bindings": [
            { "binding": "MouseButton", "button": 3 },
            { "binding": "GamepadButton", "button": "rightshoulder" }
          ]
        }
      ]
    }
  ]
}

